@EndUserText.label: 'Access control for ZI_RAP_TRAVEL_181'
@MappingRole: true
define role ZI_RAP_TRAVEL_181 {
    grant
        select
            on
                ZI_RAP_TRAVEL_181
                    where
                        CurrencyCode = 'EUR'
                        and
                        ( TravelStatus ) = aspect pfcg_auth( ZOSTAT181, ZOSTAT181, ACTVT = '03')
                        or
                        true
                        ;
                        
}